# Copie para .env e ajuste:   cp .env.example .env   (Windows: copy .env.example .env)
# NUNCA versione o arquivo .env (ele está no .gitignore).
# As senhas abaixo são APENAS exemplos de laboratório.

# Porta da API no seu computador (http://localhost:3000)
API_PORT=3000

# Banco de dados
DB_NAME=buraco
DB_USER=buraco
DB_PASSWORD=senha-exemplo-app
MYSQL_ROOT_PASSWORD=senha-exemplo-root

# Aplicação
CACHE_TTL_SECONDS=30
APP_CIDADE=Cuiabá, MT
